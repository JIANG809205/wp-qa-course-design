# ===== WordPress 测试环境变量 =====

# 被测版本（固定 tag，禁止用 latest）
WP_VERSION=6.6.2

# 安全对照版本（"修复前"的那个版本，用于双版本漏洞检出验证）
WP_OLD_VERSION=6.6.1

# 端口
WP_PORT=8080
WP_OLD_PORT=8081

# 数据库
DB_NAME=wordpress
DB_USER=wpuser
DB_PASSWORD=wp_pass_2026
DB_ROOT_PASSWORD=root_pass_2026
TABLE_PREFIX=wp_

# 站点与管理员
SITE_URL=http://localhost:8080
SITE_TITLE=WP-QA-Lab
ADMIN_USER=admin
ADMIN_PASS=Admin@2026
ADMIN_EMAIL=admin@example.com

# 初始化数据量（按机器性能调整）
POST_COUNT=1000
COMMENT_COUNT=20000
